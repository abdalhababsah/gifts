				"status": "Unprocessable Entity",
				"code": 422,
				"_postman_previewlanguage": "json",
				"header": [{ "key": "Content-Type", "value": "application/json" }],
				"body": "{\n  \"success\": false,\n  \"message\": \"Order total does not meet the minimum required for this code.\",\n  \"data\": {\"required_min_order_total\": 100.00, \"current_subtotal\": 80.00}\n}"
			  }
			]
		  },
		  {
			"name": "Clear Discount",
			"request": {
			  "method": "DELETE",
			  "header": [
				{ "key": "Accept", "value": "application/json" },
				{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
			  ],
			  "url": {
				"raw": "{{baseUrl}}/api/checkout/discount",
				"host": ["{{baseUrl}}"],
				"path": ["api", "checkout", "discount"]
