				"code": 422,
				"_postman_previewlanguage": "json",
				"header": [{ "key": "Content-Type", "value": "application/json" }],
				"body": "{\n  \"success\": false,\n  \"message\": \"This discount code usage limit has been reached.\"\n}"
			  },
			  {
				"name": "422 — Per-user limit reached",
				"originalRequest": {
				  "method": "POST",
				  "header": [
					{ "key": "Accept", "value": "application/json" },
					{ "key": "Content-Type", "value": "application/json" },
					{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
				  ],
				  "body": { "mode": "raw", "raw": "{\n  \"code\": \"ONCEONLY\"\n}" },
				  "url": { "raw": "{{baseUrl}}/api/checkout/apply-discount", "host": ["{{baseUrl}}"], "path": ["api", "checkout", "apply-discount"] }
				},
				"status": "Unprocessable Entity",
				"code": 422,
				"_postman_previewlanguage": "json",
				"header": [{ "key": "Content-Type", "value": "application/json" }],
				"body": "{\n  \"success\": false,\n  \"message\": \"You have reached the per-user usage limit for this code.\"\n}"
			  },
			  {
				"name": "422 — Minimum order not met",
				"originalRequest": {
				  "method": "POST",
				  "header": [
					{ "key": "Accept", "value": "application/json" },
					{ "key": "Content-Type", "value": "application/json" },
					{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
				  ],
				  "body": { "mode": "raw", "raw": "{\n  \"code\": \"SAVE20\"\n}" },
				  "url": { "raw": "{{baseUrl}}/api/checkout/apply-discount", "host": ["{{baseUrl}}"], "path": ["api", "checkout", "apply-discount"] }
