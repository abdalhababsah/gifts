	"item": [
	  {
		"name": "Checkout",
		"item": [
		  {
			"name": "Get Checkout Summary",
			"request": {
			  "method": "GET",
			  "header": [
				{ "key": "Accept", "value": "application/json" },
				{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
			  ],
			  "url": {
				"raw": "{{baseUrl}}/api/checkout",
				"host": ["{{baseUrl}}"],
				"path": ["api", "checkout"]
			  }
			},
			"response": [
			  {
				"name": "200 OK — Summary (no discount yet)",
				"originalRequest": {
				  "method": "GET",
				  "header": [
					{ "key": "Accept", "value": "application/json" },
					{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
				  ],
				  "url": { "raw": "{{baseUrl}}/api/checkout", "host": ["{{baseUrl}}"], "path": ["api", "checkout"] }
				},
				"status": "OK",
				"code": 200,
				"_postman_previewlanguage": "json",
				"header": [{ "key": "Content-Type", "value": "application/json" }],
				"body": "{\n  \"success\": true,\n  \"data\": {\n    \"cart\": {\n      \"items\": [\n        {\"product_id\": 12, \"name\": \"Luxury Scented Candle Set - Deluxe\", \"qty\": 1, \"unit_price\": 29.99, \"total\": 29.99},\n        {\"product_id\": 34, \"name\": \"Leather Wallet - Classic\", \"qty\": 2, \"unit_price\": 24.50, \"total\": 49.00}\n      ],\n      \"total_items\": 3,\n      \"total_amount\": 78.99\n    },\n    \"summary\": {\n      \"currency\": \"JOD\",\n      \"subtotal\": 78.99,\n      \"discount\": null,\n      \"total\": 78.99\n    },\n    \"cities\": [\n      {\"id\": 1, \"name\": \"Amman\"},\n      {\"id\": 2, \"name\": \"Irbid\"}\n    ],\n    \"time_slots\": [\n      {\"id\": 1, \"code\": \"morning\", \"name\": \"Morning Delivery\", \"window_start\": \"08:00:00\", \"window_end\": \"12:00:00\", \"crosses_midnight\": false, \"sort_order\": 1},\n      {\"id\": 2, \"code\": \"afternoon\", \"name\": \"Afternoon Delivery\", \"window_start\": \"12:00:00\", \"window_end\": \"17:00:00\", \"crosses_midnight\": false, \"sort_order\": 2}\n    ]\n  }\n}"
			  },
			  {
				"name": "200 OK — Summary (with applied discount in session)",
				"originalRequest": {
				  "method": "GET",
				  "header": [
					{ "key": "Accept", "value": "application/json" },
					{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
				  ],
				  "url": { "raw": "{{baseUrl}}/api/checkout", "host": ["{{baseUrl}}"], "path": ["api", "checkout"] }
				},
				"status": "OK",
				"code": 200,
				"_postman_previewlanguage": "json",
				"header": [{ "key": "Content-Type", "value": "application/json" }],
				"body": "{\n  \"success\": true,\n  \"data\": {\n    \"cart\": {\"items\": [], \"total_items\": 3, \"total_amount\": 200.00},\n    \"summary\": {\n      \"currency\": \"JOD\",\n      \"subtotal\": 200.00,\n      \"discount\": {\"code\": \"WELCOME10\", \"amount\": 20.00, \"type\": \"percent\", \"value\": 10, \"note\": null},\n      \"total\": 180.00\n    },\n    \"cities\": [],\n    \"time_slots\": []\n  }\n}"
			  }
			]
		  },
		  {
			"name": "Apply Discount",
